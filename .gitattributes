# Normaliza los finales de línea: LF en el repositorio y en todas las máquinas,
# sin depender de la configuración core.autocrlf de cada desarrollador.
* text=auto eol=lf

# Binarios: Git no debe tocarlos
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
