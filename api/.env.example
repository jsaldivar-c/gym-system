# Copia este archivo como .env y llena los valores. NUNCA subas .env a Git.
# Supabase → Project Settings → Database → Connection string

# Conexión por pooler (puerto 6543): la usa la app en tiempo de ejecución
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (puerto 5432): la usa Prisma para migraciones
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Dominio permitido por CORS (el frontend)
WEB_ORIGIN="http://localhost:5173"

PORT=3000
